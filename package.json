{
  "name": "pixel-office",
  "displayName": "Pixel Office",
  "description": "Pixel-art office visualizing Copilot and Antigravity/Gemini autonomous agents collaborating in real-time.",
  "version": "1.4.10",
  "publisher": "Chuucommie",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chuucommie/CopilotPixel.git"
  },
  "workspaces": [
    "server",
    "webview-ui"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "vscode": "^1.105.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "pixel-office": "./dist/cli.js",
    "copilot-pixel": "./dist/cli.js",
    "copilot-agents": "./dist/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "pixel-office.showPanel",
        "title": "Pixel Office: Show Panel"
      },
      {
        "command": "pixel-office.exportDefaultLayout",
        "title": "Pixel Office: Export Layout as Default"
      },
      {
        "command": "copilot-agents.showPanel",
        "title": "Pixel Office: Show Panel (Legacy Alias)"
      },
      {
        "command": "copilot-agents.exportDefaultLayout",
        "title": "Pixel Office: Export Layout as Default (Legacy Alias)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "pixel-office-panel",
          "title": "Pixel Office",
          "icon": "$(window)"
        }
      ]
    },
    "views": {
      "pixel-office-panel": [
        {
          "type": "webview",
          "id": "pixel-office.panelView",
          "name": "Pixel Office"
        }
      ]
    },
    "configuration": {
      "title": "Pixel Office",
      "properties": {
        "pixel-office.autoShowPanel": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show the Pixel Office panel on startup."
        },
        "pixel-office.autoSpawnAgent": {
          "type": "boolean",
          "default": true,
          "description": "Automatically spawn an agent when a supported AI session starts."
        },
        "copilot-agents.autoShowPanel": {
          "type": "boolean",
          "default": true,
          "description": "Legacy alias for pixel-office.autoShowPanel."
        },
        "copilot-agents.autoSpawnAgent": {
          "type": "boolean",
          "default": true,
          "description": "Legacy alias for pixel-office.autoSpawnAgent."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "prepack": "npm run package",
    "build:extension": "node esbuild.js --production",
    "build:webview": "cd webview-ui && npm run build",
    "compile": "npm run asyncapi:generate && npm run check-types && npm run lint && node esbuild.js && npm run build:webview",
    "build": "npm run compile",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run asyncapi:generate && npm run check-types && npm run lint && node esbuild.js --production && npm run build:webview",
    "asyncapi:generate": "tsx scripts/generate-messages.ts",
    "asyncapi:validate": "node scripts/validate-asyncapi.mjs",
    "check-types": "tsc --noEmit && tsc --noEmit -p server/tsconfig.test.json",
    "prepare": "husky",
    "lint": "eslint adapters/vscode server core && cd webview-ui && eslint .",
    "lint:fix": "eslint adapters/vscode server core --fix && cd webview-ui && eslint . --fix",
    "import-tileset": "tsx scripts/import-tileset-cli.ts",
    "format": "prettier --write \"adapters/vscode/**/*.ts\" \"server/**/*.ts\" \"core/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "format:check": "prettier --check \"adapters/vscode/**/*.ts\" \"server/**/*.ts\" \"core/src/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "test:webview": "cd webview-ui && npm test",
    "test:server": "cd server && npm test",
    "test:package-contract": "node --test scripts/npm-package-contract.test.mjs",
    "test": "npm run test:webview && npm run test:server && npm run test:package-contract",
    "verify:npm-package": "node scripts/verify-npm-package.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:debug": "node scripts/run-e2e.mjs --debug",
    "e2e:inventory": "node scripts/generate-e2e-inventory.mjs",
    "test:report": "node scripts/build-allure-report.mjs",
    "test:report:open": "allure open allure-report/allure",
    "e2e:report": "npm run test:report",
    "vercel:prepare": "npm run test:report && node scripts/assemble-vercel-output.mjs",
    "knip": "knip",
    "typecheck": "npm run check-types"
  },
  "devDependencies": {
    "@asyncapi/modelina": "^5.10.1",
    "@asyncapi/parser": "^3.6.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.x",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^16.3.2",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "adapters/vscode/**/*.ts": "eslint --fix",
    "server/**/*.ts": "eslint --fix",
    "core/src/**/*.ts": "eslint --fix",
    "webview-ui/src/**/*.{ts,tsx}": "eslint --fix",
    "scripts/**/*.{js,mjs}": "prettier --write",
    "*.{ts,tsx,js,mjs,css,json,md}": "prettier --write",
    "webview-ui/**/*.{ts,tsx,js,css,json}": "prettier --write"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7"
  },
  "overrides": {
    "jsonpath-plus": "^10.4.0",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.1.1",
    "json-schema-migrate": {
      "ajv": "^6.15.0"
    },
    "webapi-parser": {
      "ajv": "^6.15.0"
    }
  },
  "bugs": {
    "url": "https://github.com/Chuucommie/CopilotPixel/issues"
  },
  "homepage": "https://github.com/Chuucommie/CopilotPixel#readme"
}
